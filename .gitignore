# Everything is ignored by default. Nothing reaches the repository by accident:
# to publish a file, add a line to the whitelist below (or use `git add -f`),
# and check it against PUBLIC_POLICY.md first.
*

# Whitelist: files that are deliberately public.
!.gitignore
!README.md
!LICENSE
!PUBLIC_POLICY.md
!CONTRIBUTING.md
!requirements.txt
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.github/dependabot.yml
!simulation/
!simulation/test_instalacion.py
!simulation/sim_brazo.py
!simulation/loop_autocorreccion.py
!simulation/error_model.py
!simulation/sweep_errores.py
!firmware/
!firmware/README.md
!firmware/core/
!firmware/core/controller.h
!firmware/core/controller.cpp
!firmware/core/step_queue.h
!firmware/board/
!firmware/board/build.sh
!firmware/board/controller_board/
!firmware/board/controller_board/controller_board.ino
!firmware/board/controller_board/board_config.h
!firmware/tests/
!firmware/tests/test_controller.cpp
!firmware/tests/test_board.cpp
!firmware/tests/mutation_check.py
!firmware/tests/test_fuzz.cpp
!firmware/tests/coverage_check.py
!cad/
!cad/README.md
!cad/params.py
!cad/wiring.py
!cad/check_report.py
!cad/test_modules.py
!cad/expected_report.json
!cad/layout.py
!cad/modules/
!cad/modules/*.py
!host/
!host/README.md
!host/coords/
!host/coords/*.py
!host/link/
!host/link/*.py
!firmware/sim/
!firmware/core/tool_table.h
!firmware/tests/test_tools.cpp
!tools/
!tools/README.md
!tools/gen_tool_table.py
!tools/test_gen_tool_table.py
!tools/*/
!tools/*/descriptor.yaml
!firmware/sim/sim_main.cpp
!cad/parts.py
!cad/build.py
!cad/render.py
!cad/params_report.py
!cad/system.py
!cad/system_parts.py
!cad/mech_review.py
!requirements-cad.txt
!docs/
!docs/media/
!docs/media/self_correction_loop.gif
!docs/media/self_correction_loop.mp4

# Secrets and private material. Keep this block last so nothing above can
# re-include it, and never whitelist these.
.env
.env.*
*.env
*.key
*.pem
secrets/
credentials*
phase3/
